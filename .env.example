# Copie en .env pour un lancement hors Docker (python -m mymoney.cli serve)
MYMONEY_DATA_DIR=./data
MYMONEY_PUBLIC_URL=http://localhost:8000
MYMONEY_COOKIE_SECURE=false
MYMONEY_AUTO_LOCK_MINUTES=15
MYMONEY_AUTO_SYNC_HOURS=6
MYMONEY_MAX_UPLOAD_MB=25
# Coût Argon2id (mémoire en Kio, passes). Augmente si ton NAS a de la RAM.
MYMONEY_ARGON2_MEMORY_KIB=131072
MYMONEY_ARGON2_TIME_COST=3
# MYMONEY_UNLOCK_PASSWORD_FILE=/run/secrets/mymoney_password
